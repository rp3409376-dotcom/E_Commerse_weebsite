{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": false
  },
  "typeAcquisition": {
    "enable": true
  },
  "include": [
    "frontend/src/**/*.js",
    "frontend/src/**/*.jsx",
    "backend/**/*.js"
  ],
  "exclude": ["node_modules", "frontend/dist"]
}
